<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".activities.actions.AccessActionsActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        style="@style/AppbarAppearance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_round_keyboard_backspace_24"
            app:title="@string/access_panel"
            app:titleTextAppearance="@style/ToolbarTitleAppearance" />

    </com.google.android.material.appbar.AppBarLayout>


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/appbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/grey_200">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.aravi.dot.ui.views.SwitchSettingsView
                        android:id="@+id/camera_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        app:icon="@drawable/ic_round_camera"
                        app:icon_tint="@color/deep_purple_400"
                        app:message="@string/camera_monitoring_message"
                        app:title="@string/permission_camera" />

                    <com.aravi.dot.ui.views.SwitchSettingsView
                        android:id="@+id/microphone_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        app:icon="@drawable/ic_round_mic"
                        app:icon_tint="@color/orange_400"
                        app:message="@string/microphone_monitoring_message"
                        app:title="@string/permission_microphone" />


                    <com.aravi.dot.ui.views.SwitchSettingsView
                        android:id="@+id/location_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        app:icon="@drawable/ic_round_location"
                        app:icon_tint="@color/blue_500"
                        app:message="@string/location_monitoring_message"
                        app:title="@string/permission_location" />


                </LinearLayout>


            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:padding="5dp"
                android:text="@string/access_log_settings"
                android:textAlignment="center"
                android:textSize="18sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/grey_200">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.aravi.dot.ui.views.SettingsView
                        android:id="@+id/excluded_apps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        app:icon="@drawable/ic_round_dashboard_24"
                        app:iconVisibility="false"
                        app:icon_tint="@color/green_300"
                        app:message="@string/excluded_apps_message"
                        app:title="@string/whitelist_title" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:weightSum="3">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/excluded_apps_button"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="5dp"
                            android:layout_weight="1"
                            android:text="@string/whitelist_title" />


                    </LinearLayout>

                    <com.aravi.dot.ui.views.SwitchSettingsView
                        android:id="@+id/time_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        app:icon="@drawable/ic_round_access_time_24"
                        app:icon_tint="@color/indigo_400"
                        app:message="@string/relative_time_message"
                        app:title="@string/relative_time" />

                    <com.aravi.dot.ui.views.SettingsView
                        android:id="@+id/clear_logs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        app:icon="@drawable/ic_round_clear_24"
                        app:iconVisibility="true"
                        app:icon_tint="@color/red_300"
                        app:message="@string/clear_access_logs_message"
                        app:title="@string/clear_access_logs" />

                </LinearLayout>


            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


</RelativeLayout>
